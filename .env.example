# Copy to .env and replace every change-me value before starting Compose.
GKS_ENVIRONMENT=development
GKS_LOG_LEVEL=INFO
GKS_SERVICE_TOKEN=change-me-use-at-least-32-random-characters

GKS_POSTGRES_DB=graphrag
GKS_POSTGRES_USER=graphrag
GKS_POSTGRES_PASSWORD=change-me-postgres-password
GKS_POSTGRES_PORT=56001

GKS_QDRANT_HTTP_PORT=6433
GKS_QDRANT_GRPC_PORT=6434

GKS_NEO4J_PASSWORD=change-me-neo4j-password
GKS_NEO4J_HTTP_PORT=7474
GKS_NEO4J_BOLT_PORT=7687
GKS_NEO4J_HEAP_INITIAL=512m
GKS_NEO4J_HEAP_MAX=1G
GKS_NEO4J_PAGECACHE=512m

GKS_API_PORT=8080
GKS_VAULT_HOST_PATH=/mnt/d/hack/MCP_Test_ObsidianVault
GKS_VAULT_ALLOWED_ROOTS=["/mnt/d/hack/MCP_Test_ObsidianVault"]
GKS_MAX_MARKDOWN_NOTE_BYTES=20971520

# Optional LM Studio-compatible generation endpoint. It remains a non-required
# readiness capability while disabled.
GKS_GENERATION_PROVIDER_ENABLED=false
GKS_GENERATION_PROVIDER_URL=http://127.0.0.1:1234/v1
GKS_GENERATION_PROVIDER_API_KEY=
GKS_GENERATION_MODEL=qwen/qwen3.5-9b
GKS_GENERATION_REASONING_EFFORT=none
GKS_GENERATION_TIMEOUT_SECONDS=180
GKS_GENERATION_MAX_TOKENS=4096
GKS_EXTRACTION_MAX_CHUNKS_PER_JOB=20
# Optional LM Studio-compatible embedding endpoint. Dimension is probed at runtime.
GKS_EMBEDDING_PROVIDER_ENABLED=false
GKS_EMBEDDING_PROVIDER_URL=http://127.0.0.1:1234/v1
GKS_EMBEDDING_PROVIDER_API_KEY=
GKS_EMBEDDING_MODEL=text-embedding-bge-m3
GKS_EMBEDDING_BATCH_SIZE=16
GKS_PROJECTION_BATCH_SIZE=16
GKS_GRAPH_PROJECTION_MAX_OBJECTS=20000
GKS_RETRIEVAL_ENTITY_LIMIT=10
GKS_RETRIEVAL_CLAIM_LIMIT=20
GKS_RETRIEVAL_GRAPH_MAX_HOPS=2
GKS_RETRIEVAL_GRAPH_MAX_PATHS=20
GKS_RETRIEVAL_DOCUMENT_CONTEXT_MAX_DOCUMENTS=1
GKS_RETRIEVAL_DOCUMENT_CONTEXT_MAX_CHUNKS_PER_DOCUMENT=32
GKS_RETRIEVAL_DOCUMENT_CONTEXT_MAX_CHARS=30000

